# syntax=docker/dockerfile:1.4

ARG BUILDER_BASE=amd64
FROM docker.io/tritonn204/tnn-builder-${BUILDER_BASE}:latest AS base
#FROM tnn-builder-${BUILDER_BASE}:latest AS base

# Set environment variable to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /src

#COPY ./scripts/prereqs.sh ./scripts/prereqs.sh
#RUN chmod +x ./scripts/prereqs.sh && ./scripts/prereqs.sh

FROM base AS build
# Ensure HIP/ROCm/CUDA env vars are set for GPU builds (no-op for CPU builds)
ENV HIP_PATH=/opt/rocm
ENV ROCM_PATH=/opt/rocm
ENV CUDA_PATH=/usr/local/cuda
ENV PATH="/usr/local/cuda/bin:${PATH}"
ARG  CMAKE_ARGS=
ARG  PACKAGE_VERSION=0.0.1
ARG  TARGZ_FILE=miner.tar.gz
RUN pwd
RUN ls -la .
#RUN ls -la ./scripts/

COPY . .

RUN ls -la .

RUN chmod +x ./scripts/*.sh
RUN --mount=type=cache,target=/src/_deps ./scripts/prereqs.sh
RUN --mount=type=cache,target=/src/_deps mkdir ./build && cd ./build && cmake $CMAKE_ARGS -DTNN_VERSION=$PACKAGE_VERSION ..
RUN --mount=type=cache,target=/src/_deps cd ./build && make -j$(nproc)
RUN ls -la ./build/bin/ ./build/ && mv ./build/bin/tnn-miner-* ./ || mv ./build/tnn-miner-* ./
# Copy tunes directory (created by CMake post-build from default-tunes)
RUN if [ -d ./build/bin/tunes ]; then cp -r ./build/bin/tunes ./tunes; elif [ -d ./build/tunes ]; then cp -r ./build/tunes ./tunes; fi
#RUN ./tnn-miner-* --test-spectre
# Bundle GPU runtime .so files for wrapper compatibility with older HiveOS
# NVRTC for CUDA builds (ensures __maxnreg__ works on older drivers)
RUN mkdir -p ./nvrtc_libs && \
    (cp /usr/local/cuda/lib64/libnvrtc.so* ./nvrtc_libs/ 2>/dev/null || true) && \
    (cp /usr/local/cuda/lib64/libnvrtc-builtins.so* ./nvrtc_libs/ 2>/dev/null || true) && \
    ls -la ./nvrtc_libs/ || true
# HIP/ROCm runtime + HIPRTC for AMD builds
RUN mkdir -p ./hip_libs && \
    (cp /opt/rocm/lib/libamdhip64.so* ./hip_libs/ 2>/dev/null || true) && \
    (cp /opt/rocm/lib/libhiprtc.so* ./hip_libs/ 2>/dev/null || true) && \
    (cp /opt/rocm/lib/libhiprtc-builtins.so* ./hip_libs/ 2>/dev/null || true) && \
    (cp /opt/rocm/lib/libhsa-runtime64.so* ./hip_libs/ 2>/dev/null || true) && \
    (cp /opt/rocm/lib/libamd_comgr.so* ./hip_libs/ 2>/dev/null || true) && \
    ls -la ./hip_libs/ || true
RUN ls -la ./
RUN tar -czvf ${TARGZ_FILE} ./tnn-miner* ./tunes \
    $([ -n "$(ls ./nvrtc_libs/ 2>/dev/null)" ] && echo "./nvrtc_libs") \
    $([ -n "$(ls ./hip_libs/ 2>/dev/null)" ] && echo "./hip_libs")
RUN md5sum ./${TARGZ_FILE}

FROM scratch
ARG  PACKAGE_VERSION
ARG  TARGZ_FILE=miner.tar.gz
COPY --from=build /src/${TARGZ_FILE} /
COPY --from=build /src/tnn-miner* /
COPY --from=build /src/tunes/ /tunes/
COPY --from=build /src/nvrtc_libs/ /nvrtc_libs/
COPY --from=build /src/hip_libs/ /hip_libs/
