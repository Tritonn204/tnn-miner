# syntax=docker/dockerfile:1.4

ARG BUILDER_BASE=amd64
FROM docker.io/tritonn204/tnn-builder-${BUILDER_BASE}:latest AS base
#FROM tnn-builder-${BUILDER_BASE}:latest AS base

# Set environment variable to avoid interactive prompts
ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /src

#COPY ./scripts/prereqs.sh ./scripts/prereqs.sh
#RUN chmod +x ./scripts/prereqs.sh && ./scripts/prereqs.sh

FROM base AS build

# HIP/ROCm/CUDA env vars (set by base image, repeated here for clarity)
ENV HIP_PATH=/opt/rocm
ENV ROCM_PATH=/opt/rocm
ARG  CMAKE_ARGS=
ARG  PACKAGE_VERSION=0.0.1
ARG  TARGZ_FILE=miner.tar.gz
RUN pwd
RUN ls -la .
#RUN ls -la ./scripts/

COPY . .

RUN ls -la .

RUN chmod +x ./scripts/*.sh
RUN --mount=type=cache,target=/src/_deps ./scripts/prereqs.sh
RUN --mount=type=cache,target=/src/_deps mkdir ./build && cd ./build && cmake $CMAKE_ARGS -DTNN_VERSION=$PACKAGE_VERSION ..
RUN --mount=type=cache,target=/src/_deps cd ./build && make -j$(nproc)
RUN ls -la ./build/bin/ ./build/ && mv ./build/bin/tnn-miner* ./ || mv ./build/tnn-miner* ./
# Copy tunes directory (created by CMake post-build from default-tunes)
RUN if [ -d ./build/bin/tunes ]; then cp -r ./build/bin/tunes ./tunes; elif [ -d ./build/tunes ]; then cp -r ./build/tunes ./tunes; fi
#RUN ./tnn-miner-* --test-spectre

# Collect GPU runtime libs for HiveOS/mmpOS wrapper bundling
ARG CMAKE_ARGS
RUN mkdir -p ./libs && \
    if echo "$CMAKE_ARGS" | grep -q "WITH_OROCHI=ON"; then \
      echo "Collecting GPU runtime libs for Orochi bundle..." && \
      # ROCm/HIP runtime chain
      for lib in libamdhip64.so libhiprtc.so libamd_comgr.so \
                 libhsa-runtime64.so librocm_smi64.so \
                 librocprofiler-register.so \
                 libdrm.so libdrm_amdgpu.so; do \
        found=$(find /opt/rocm/lib /usr/lib/x86_64-linux-gnu -maxdepth 1 \
                     -name "${lib}*" 2>/dev/null | head -1); \
        if [ -n "$found" ]; then \
          # Copy the actual file, name it as the unversioned soname
          soname=$(objdump -p "$found" 2>/dev/null | grep SONAME | awk '{print $2}') || true; \
          if [ -n "$soname" ]; then \
            cp "$found" "./libs/$soname"; \
          else \
            cp "$found" "./libs/$(basename "$found")"; \
          fi; \
          echo "  bundled: $(basename "$found") -> libs/"; \
        fi; \
      done && \
      ls -la ./libs/; \
    fi

RUN ls -la ./
RUN tar -czvf ${TARGZ_FILE} ./tnn-miner* ./tunes $([ -d ./libs ] && [ "$(ls -A ./libs 2>/dev/null)" ] && echo "./libs")
RUN md5sum ./${TARGZ_FILE}

FROM scratch
ARG  PACKAGE_VERSION
ARG  TARGZ_FILE=miner.tar.gz
COPY --from=build /src/${TARGZ_FILE} /
COPY --from=build /src/tnn-miner* /
COPY --from=build /src/tunes/ /tunes/
COPY --from=build /src/libs/ /libs/
