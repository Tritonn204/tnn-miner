# syntax=docker/dockerfile:1.4

FROM ubuntu:noble AS ubuntu24-base
ARG APT_PACKAGES="gpg git wget build-essential clang libssl-dev libudns-dev libc++-dev lld libsodium-dev libnuma-dev ca-certificates curl"

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends ${APT_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://apt.kitware.com/kitware-archive.sh | bash \
 && apt-get update \
 && apt-get install -y --no-install-recommends cmake \
 && cmake --version \
 && rm -rf /var/lib/apt/lists/*

FROM rocm/dev-ubuntu-24.04:6.4.4 AS ubuntu24-rocm
ARG APT_PACKAGES="gpg git wget build-essential clang libssl-dev libudns-dev libc++-dev lld libsodium-dev libnuma-dev ca-certificates curl"

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update \
 && apt-get install -y --no-install-recommends ${APT_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://apt.kitware.com/kitware-archive.sh | bash \
 && apt-get update \
 && apt-get install -y --no-install-recommends cmake \
 && cmake --version \
 && rm -rf /var/lib/apt/lists/*
